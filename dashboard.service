[Unit]
Description=Hygrometer browser dashboard
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=%h/bluetooth-hygrometer-reader-tp357
ExecStart=/usr/bin/python3 %h/bluetooth-hygrometer-reader-tp357/dashboard.py
Restart=always
RestartSec=30
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
